// Gplus junk rules. The live copy is %ProgramData%\Gplus\rules.json - edit that one; the service
// reloads it automatically on the next sweep (no restart needed).
//
// Scoring: every matching signal adds (or subtracts) points. A message whose total reaches
// "Threshold" is junk. Run "Gplus scan" to see the score and reasons for each unread message.
//
// Patterns are case-insensitive .NET regular expressions (in JSON, write \b as \\b).
// Text is normalized first, so bold/fullwidth Unicode letters, zero-width characters hidden between
// letters, and accented look-alikes all still match plain "loan".
{
  "Threshold": 6,

  // Never touched. "person@x.com", "*@x.com", or a bare domain "x.com" (also covers mail.x.com).
  // People you have sent email to are learned automatically and don't need listing here.
  "AllowSenders": [
    // "mybank.com",
    // "mom@example.com"
  ],

  // Always removed (unless also allow-listed).
  "BlockSenders": [
    "temu.com",
    "shein.com",
    "temuemail.com"
  ],

  "Signals": {
    "ListUnsubscribe": 3,
    "PrecedenceBulk": 1,
    "BulkMailer": 1,
    "GmailPromotions": 3,
    "GmailSocial": 0,
    "GmailUpdates": 0,
    "GmailForums": 0,
    "GmailImportant": -2,
    "AuthFail": 4,
    "BrandSpoof": 5,
    "ReplyToMismatch": 1,
    "NotAddressedToMe": 1,
    "NoReplySender": 1,
    "MarketingSubdomain": 1,
    "PreheaderPadding": 1,
    "ShoutySubject": 1,
    "ManyLinks": 1,
    "ImageOnly": 1
  },

