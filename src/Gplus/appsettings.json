{
  // To override any of these without touching the install folder, put an appsettings.json with
  // just the keys you want to change in %ProgramData%\Gplus. Changes are picked up live.
  "Gplus": {
    // What happens to junk: "Trash" (recoverable for 30 days), "Spam" (also trains Gmail's
    // filter), or "Archive" (just leaves the inbox; stays under the label forever).
    "Action": "Trash",
    // Every removed message also gets this label, so "label:Gplus-Removed" finds them all,
    // including in Trash.
    "RemovedLabel": "Gplus-Removed",
    // Training labels (created in Gmail on the first sweep). Put junk in Gplus-Train and Gplus
    // blocks its sender, then removes it. Put a wrongly removed message in Gplus-NotJunk and Gplus
    // allows its sender and moves it back to the inbox. What it learns goes in learned.json.
    "LearnFromLabels": true,
    "TrainLabel": "Gplus-Train",
    "NotJunkLabel": "Gplus-NotJunk",
    // true = log what would be removed but don't touch anything.
    "DryRun": false,
    "PollIntervalSeconds": 300,
    "Query": "is:unread in:inbox newer_than:30d",
    "MaxPerPass": 250,
    // Other addresses (or whole domains) that forward into this Gmail and count as "you".
    // Your Gmail address and send-as aliases are included automatically.
    "MyAddresses": [ "doctorate.cc" ],
    // Never remove mail from people you've sent email to (learned from your Sent folder).
    "LearnCorrespondents": true,
    "CorrespondentRefreshHours": 12,
    "CorrespondentScanMax": 2000,
    "LogRetentionDays": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Warning",
      "System.Net.Http": "Warning"
    },
    "EventLog": {
      "LogLevel": { "Default": "Warning" }
    }
  }
}
